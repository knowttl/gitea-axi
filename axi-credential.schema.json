{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gitea profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["origin", "tokenOrigin", "token"],
  "properties": {
    "origin": { "type": "string", "pattern": "^https?://[^/@?#\\s]+$" },
    "tokenOrigin": { "type": "string", "pattern": "^https?://[^/@?#\\s]+$" },
    "token": {
      "x-secret": true,
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["env"], "properties": { "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } } },
        { "type": "object", "additionalProperties": false, "required": ["file"], "properties": { "file": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/])" } } }
      ]
    },
    "allowInsecureHttp": { "type": "boolean", "default": false },
    "writes": {
      "type": "object", "additionalProperties": false, "required": ["allowWrites", "operations"],
      "properties": { "allowWrites": { "type": "boolean" }, "operations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } }
    }
  },
  "if": { "properties": { "origin": { "pattern": "^http:" } } },
  "then": { "required": ["allowInsecureHttp"], "properties": { "allowInsecureHttp": { "const": true } } }
}
