{
  "name": "@knowttl/gitea-axi",
  "version": "0.1.0",
  "description": "An agent CLI for Gitea repository workflows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowttl/gitea-axi.git"
  },
  "type": "module",
  "bin": { "gitea-axi": "dist/cli.js" },
  "publishConfig": { "access": "public" },
  "files": ["dist", "schemas", "generated", "axi-credential.schema.json"],
  "engines": { "node": ">=24.11.0 <25" },
  "packageManager": "npm@11.9.0",
  "overrides": { "ignore": "7.0.13" },
  "scripts": {
    "build": "tsc && node scripts/generate.mjs --check",
    "generate": "tsc && node scripts/generate.mjs",
    "generate:check": "tsc && node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tooling.json",
    "lint": "eslint . && npm run generate:check",
    "test": "node --import ./scripts/deny-network.ts scripts/verify-suite.mjs",
    "check": "node scripts/check.mjs --offline"
  },
  "dependencies": {
    "@toon-format/toon": "2.3.1",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1"
  }
}
