{
  "name": "@knowttl/gitea-axi",
  "version": "0.1.4",
  "description": "An agent CLI for Gitea repository workflows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowttl/gitea-axi.git"
  },
  "type": "module",
  "bin": {
    "gitea-axi": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "schemas",
    "generated",
    "axi-credential.schema.json"
  ],
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "overrides": {
    "ignore": "7.0.13"
  },
  "scripts": {
    "build": "tsc && node scripts/generate.ts --check",
    "generate": "tsc && node scripts/generate.ts",
    "generate:check": "tsc && node scripts/generate.ts --check",
    "typecheck": "tsc && tsc -p tsconfig.tooling.json",
    "lint": "eslint --flag unstable_native_nodejs_ts_config . && npm run generate:check",
    "test": "node --import ./scripts/deny-network.ts scripts/verify-suite.ts",
    "check": "node scripts/check.ts --offline"
  },
  "dependencies": {
    "@toon-format/toon": "2.3.1",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1"
  }
}
